# ============================================================================
# 24 HITS OS — variables de entorno (ejemplo). Copia a .env y ajusta.
# NINGÚN secreto real debe commitearse. Los valores aquí son solo de desarrollo.
# ============================================================================

NODE_ENV=development

# --- Base de datos (PostgreSQL / Docker Compose local) ---
# Runtime (usa PgBouncer/pool si aplica). En local apunta directo al contenedor.
DATABASE_URL="postgresql://hits:hits@localhost:5432/hits_os?schema=public"
# Conexión directa para migraciones (Prisma la usa en migrate/seed).
DIRECT_URL="postgresql://hits:hits@localhost:5432/hits_os?schema=public"

# --- Redis (colas BullMQ, rate limiting, cache) ---
REDIS_URL="redis://localhost:6379"

# --- Autenticación ---
# Secretos independientes para access y refresh. Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-cambia-esto-por-uno-largo-y-aleatorio"
JWT_REFRESH_SECRET="dev-refresh-secret-cambia-esto-por-uno-largo-y-aleatorio"
JWT_ACCESS_TTL="900"          # 15 min en segundos
JWT_REFRESH_TTL="2592000"     # 30 días en segundos

# --- URLs de la aplicación ---
APP_URL="http://localhost:3000"   # frontend (Next.js)
API_URL="http://localhost:4000"   # backend (NestJS)

# --- Almacenamiento de archivos (MinIO local / S3-compatible en prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="hits-private"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"        # requerido por MinIO

# --- Observabilidad (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="hits-api"

# --- Email ---
# "console" (dev): simula el envío en consola, no requiere claves.
# "resend": envía de verdad vía Resend (https://resend.com). Requiere RESEND_API_KEY
#   y que EMAIL_FROM use un dominio VERIFICADO en Resend. Para pruebas rápidas sin
#   verificar dominio: EMAIL_FROM="onboarding@resend.dev" (solo entrega a tu propio correo).
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@24hits.local"
# RESEND_API_KEY="re_..."   # solo cuando EMAIL_PROVIDER=resend — NUNCA commitear la real

# ============================================================================
