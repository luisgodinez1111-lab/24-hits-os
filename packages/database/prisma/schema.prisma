  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId, variantId])
}

// ==========================================================================
//  COMPRAS Y PROVEEDORES (ADR-018, ADR-019)
// ==========================================================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Supplier {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @db.Uuid
  name             String
  legalName        String?
  taxId            String?
  email            String?
  phone            String?
  address          String?
  currency         String         @default("MXN") @db.Char(3)
  paymentTermsDays Int?
  status           SupplierStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  references     ProductSupplierReference[]
  purchaseOrders PurchaseOrder[]
  receipts       PurchaseReceipt[]

  @@index([organizationId, status])
}

model ProductSupplierReference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  supplierId     String   @db.Uuid
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId      String   @db.Uuid
  supplierSku    String?
  lastCost       Decimal? @db.Decimal(18, 4)
  leadTimeDays   Int?
  isPreferred    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supplierId, variantId])
  @@index([organizationId, variantId])
}

model PurchaseOrder {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @db.Uuid
  supplierId        String              @db.Uuid
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId       String              @db.Uuid
  branchId          String              @db.Uuid
  number            String
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String              @default("MXN") @db.Char(3)
  notes             String?
  expectedDate      DateTime?
  subtotal          Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal          Decimal             @default(0) @db.Decimal(18, 4)
  total             Decimal             @default(0) @db.Decimal(18, 4)
  requestedByUserId String              @db.Uuid
  approvedByUserId  String?             @db.Uuid
  orderedAt         DateTime?
  correlationId     String?
  idempotencyKey    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String        @db.Uuid
  purchaseOrderId  String        @db.Uuid
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String        @db.Uuid
  orderedQuantity  Decimal       @db.Decimal(18, 6)
  unitCost         Decimal       @db.Decimal(18, 4)
  taxRate          Decimal       @default(0) @db.Decimal(5, 4)
  receivedQuantity Decimal       @default(0) @db.Decimal(18, 6)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([organizationId, variantId])
}

model PurchaseReceipt {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @db.Uuid
  supplierId       String                @db.Uuid
  supplier         Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId      String                @db.Uuid
  branchId         String                @db.Uuid
  purchaseOrderId  String?               @db.Uuid
  number           String
  status           PurchaseReceiptStatus @default(DRAFT)
  notes            String?
  receivedByUserId String                @db.Uuid
  postedAt         DateTime?
  correlationId    String?
  idempotencyKey   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  items PurchaseReceiptItem[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model PurchaseReceiptItem {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid
  purchaseReceiptId   String          @db.Uuid
  purchaseReceipt     PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  variantId           String          @db.Uuid
  quantity            Decimal         @db.Decimal(18, 6)
  unitCost            Decimal         @db.Decimal(18, 4)
  purchaseOrderItemId String?         @db.Uuid
  createdAt           DateTime        @default(now())

  @@index([purchaseReceiptId])
  @@index([organizationId, variantId])
}

// ==========================================================================
//  VENTAS Y PEDIDOS (ADR-020, ADR-021)
// ==========================================================================

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Zona del estado de Chihuahua para segmentar entregas y analítica.
enum CustomerZone {
  NORTE
  SUR
  ESTE
  OESTE
  CENTRO
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

// Estado de entrega para el modelo por pedido/domicilio.
enum DeliveryStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

model Customer {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  code           String? // número de cliente (autogenerado C-0001, editable)
  name           String
  legalName      String?
  email          String?
  phone          String?
  address        String?
  zone           CustomerZone?
  lat            Float? // última ubicación conocida (para prellenar entregas)
  lng            Float?
  taxId          String?
  type           CustomerType   @default(RETAIL)
  creditLimit    Decimal?       @db.Decimal(18, 4)
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  orders Order[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, zone])
}

model Order {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid
  branchId            String          @db.Uuid
  warehouseId         String          @db.Uuid
  customerId          String?         @db.Uuid
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  number              String
  status              OrderStatus     @default(DRAFT)
  channel             String?
  currency            String          @default("MXN") @db.Char(3)
  priceListId         String?         @db.Uuid
  subtotal            Decimal         @default(0) @db.Decimal(18, 4)
  discountTotal       Decimal         @default(0) @db.Decimal(18, 4)
  taxTotal            Decimal         @default(0) @db.Decimal(18, 4)
  total               Decimal         @default(0) @db.Decimal(18, 4)
  paymentStatus       PaymentStatus   @default(PENDING)
  notes               String?
  // Entrega a domicilio (pedidos por WhatsApp → domicilio/ubicación).
  deliveryAddress     String?
  deliveryPhone       String?
  deliveryNotes       String?
  deliveryLocationUrl String?
  deliveryLat         Float? // lat/lng extraídos del link (Google/Apple Maps) para la ruta
  deliveryLng         Float?
  deliveryStatus      DeliveryStatus?
  // Prueba de entrega (geo-sello): dónde/cuándo/quién al marcar DELIVERED. Evidencia
  // difícil de falsear de que el repartidor estuvo físicamente en el punto de entrega.
  deliveredAt         DateTime?
  deliveredLat        Float? // ubicación del REPARTIDOR al entregar (no la del cliente)
  deliveredLng        Float?
  deliveredAccuracy   Float? // precisión del GPS en metros (calidad del sello)
  deliveredByUserId   String?         @db.Uuid // quién cerró la entrega
  deliveryRecipient   String? // quién recibió (nombre; opcional)
  // Dispatch: repartidor asignado a la entrega. null = pool común (lo ve cualquiera).
  assignedDriverId    String?         @db.Uuid
  confirmedAt         DateTime?
  fulfilledAt         DateTime?
  cancelledAt         DateTime?
  createdByUserId     String          @db.Uuid
  correlationId       String?
  idempotencyKey      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  items       OrderItem[]
  payments    Payment[]
  saleNotes   SaleNote[]
  creditNotes CreditNote[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  // Índices multi-tenant (lideran por organizationId): lista por fecha, ruta de
  // reparto (deliveryStatus) y cuentas por cobrar (paymentStatus).
  @@index([organizationId, createdAt])
  @@index([organizationId, deliveryStatus])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, assignedDriverId]) // dispatch: paradas por repartidor
  @@index([customerId])
}

model OrderItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @db.Uuid
  orderId           String   @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String   @db.Uuid
  quantity          Decimal  @db.Decimal(18, 6)
  unitPrice         Decimal  @db.Decimal(18, 4)
  discount          Decimal  @default(0) @db.Decimal(18, 4)
  taxRate           Decimal  @default(0) @db.Decimal(5, 4)
  lineTotal         Decimal  @db.Decimal(18, 4)
  reservationId     String?  @db.Uuid
  fulfilledQuantity Decimal  @default(0) @db.Decimal(18, 6)
  unitCostSnapshot  Decimal? @db.Decimal(18, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([organizationId, variantId])
}

// ---------------------------------------------------------------------------
// Pagos / Caja (Prompt 5) — ADR-022 (pagos) · ADR-023 (turnos de caja)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentEntryStatus {
  COMPLETED
  REVERSED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  DEPOSIT
  WITHDRAWAL
  EXPENSE
}

// Caja física/lógica de una sucursal. Configuración estática.
model CashRegister {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  branchId       String             @db.Uuid
  name           String
  code           String
  status         CashRegisterStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  sessions CashSession[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

// Turno de caja: apertura con fondo, cierre con arqueo. Solo UNA sesión OPEN por
// caja (índice único parcial en SQL). El efectivo esperado se deriva de sus pagos
// en efectivo + movimientos de caja (ADR-023).
model CashSession {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  branchId       String            @db.Uuid
  registerId     String            @db.Uuid
  register       CashRegister      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  status         CashSessionStatus @default(OPEN)
  openingFloat   Decimal           @default(0) @db.Decimal(18, 4)
  openedByUserId String            @db.Uuid
  openedAt       DateTime          @default(now())
  closedByUserId String?           @db.Uuid
  closedAt       DateTime?
  expectedCash   Decimal?          @db.Decimal(18, 4)
  countedCash    Decimal?          @db.Decimal(18, 4)
  difference     Decimal?          @db.Decimal(18, 4)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments  Payment[]
  movements CashMovement[]

  @@index([organizationId, status])
  @@index([registerId])
}

// Pago aplicado a un pedido. Ledger inmutable: una anulación marca el pago como
// REVERSED (no se borra). El neto pagado = suma de amount con status COMPLETED.
model Payment {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @db.Uuid
  branchId        String             @db.Uuid
  orderId         String?            @db.Uuid
  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashSessionId   String?            @db.Uuid
  cashSession     CashSession?       @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  method          PaymentMethod
  amount          Decimal            @db.Decimal(18, 4)
  currency        String             @default("MXN") @db.Char(3)
  reference       String?
  status          PaymentEntryStatus @default(COMPLETED)
  reversalOfId    String?            @unique @db.Uuid
  reversalOf      Payment?           @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy      Payment?           @relation("PaymentReversal")
  reversedAt      DateTime?
  createdByUserId String             @db.Uuid
  correlationId   String?
  idempotencyKey  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([orderId])
  @@index([organizationId, cashSessionId])
  @@index([organizationId, status])
  // Reportes de ventas/cobros por período (rango de createdAt por tenant).
  @@index([organizationId, createdAt])
}

// Movimiento de efectivo del cajón NO ligado a una venta: ingreso de fondo,
// retiro o gasto. Siempre dentro de una sesión abierta.
model CashMovement {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @db.Uuid
  cashSessionId   String           @db.Uuid
  cashSession     CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type            CashMovementType
  amount          Decimal          @db.Decimal(18, 4)
  reason          String
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())

  @@index([cashSessionId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Notas de venta (Prompt 7) — ADR-024 (comprobante inmutable + folio consecutivo)
// ---------------------------------------------------------------------------

enum SaleNoteStatus {
  ISSUED
  CANCELLED
}

// Contador de folios por serie. El consecutivo se asigna con UPDATE ... RETURNING
// (bloqueo de fila), de modo que dos notas concurrentes nunca repiten folio.
model DocumentSequence {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  series         String
  nextValue      Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, series])
}

// Comprobante de venta INMUTABLE: fotografía del pedido al emitirse (cliente,
// renglones, totales, pagado). No se edita; se cancela (nunca se borra).
model SaleNote {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @db.Uuid
  branchId          String         @db.Uuid
  orderId           String?        @db.Uuid
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId        String?        @db.Uuid
  series            String
  folio             Int
  number            String
  status            SaleNoteStatus @default(ISSUED)
  currency          String         @default("MXN") @db.Char(3)
  customerName      String?
  customerTaxId     String?
  subtotal          Decimal        @db.Decimal(18, 4)
  discountTotal     Decimal        @db.Decimal(18, 4)
  taxTotal          Decimal        @db.Decimal(18, 4)
  total             Decimal        @db.Decimal(18, 4)
  paidTotal         Decimal        @default(0) @db.Decimal(18, 4)
  notes             String?
  issuedByUserId    String         @db.Uuid
  issuedAt          DateTime       @default(now())
  cancelledByUserId String?        @db.Uuid
  cancelledAt       DateTime?
  cancelledReason   String?
  correlationId     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items       SaleNoteItem[]
  creditNotes CreditNote[]

  @@unique([organizationId, series, folio])
  @@index([organizationId, status])
  @@index([orderId])
}

// Renglón fotografiado (descripción/precios copiados; no referencia viva a la variante).
model SaleNoteItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @db.Uuid
  saleNoteId       String   @db.Uuid
  saleNote         SaleNote @relation(fields: [saleNoteId], references: [id], onDelete: Cascade)
  variantId        String?  @db.Uuid
  sku              String?
  description      String
  quantity         Decimal  @db.Decimal(18, 6)
  unitPrice        Decimal  @db.Decimal(18, 4)
  discount         Decimal  @default(0) @db.Decimal(18, 4)
  taxRate          Decimal  @default(0) @db.Decimal(5, 4)
  lineTotal        Decimal  @db.Decimal(18, 4)
  unitCostSnapshot Decimal? @db.Decimal(18, 4)

  @@index([saleNoteId])
}

// ---------------------------------------------------------------------------
// Devoluciones / notas de crédito (Prompt 8) — ADR-025
// ---------------------------------------------------------------------------

enum CreditNoteStatus {
  ISSUED
  CANCELLED
}

// Nota de crédito = devolución: reingresa mercancía al inventario (CUSTOMER_RETURN),
// revierte el COGS al costo capturado en la venta y documenta el crédito al cliente.
// Inmutable; folio consecutivo por serie (ADR-024/025).
model CreditNote {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String           @db.Uuid
  branchId            String           @db.Uuid
  orderId             String?          @db.Uuid
  order               Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  saleNoteId          String?          @db.Uuid
  saleNote            SaleNote?        @relation(fields: [saleNoteId], references: [id], onDelete: SetNull)
  customerId          String?          @db.Uuid
  series              String
  folio               Int
  number              String
  status              CreditNoteStatus @default(ISSUED)
  currency            String           @default("MXN") @db.Char(3)
  customerName        String?
  customerTaxId       String?
  subtotal            Decimal          @db.Decimal(18, 4)
  discountTotal       Decimal          @db.Decimal(18, 4)
  taxTotal            Decimal          @db.Decimal(18, 4)
  total               Decimal          @db.Decimal(18, 4)
  reason              String
  refundMethod        PaymentMethod?
  refundCashSessionId String?          @db.Uuid
  issuedByUserId      String           @db.Uuid
  issuedAt            DateTime         @default(now())
  correlationId       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items CreditNoteItem[]

  @@unique([organizationId, series, folio])
  @@index([organizationId, status])
  @@index([saleNoteId])
  @@index([orderId])
}

// Renglón devuelto (snapshot). Referencia el renglón original de la nota de venta
// para controlar la cantidad acumulada devuelta (no exceder lo vendido).
model CreditNoteItem {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String     @db.Uuid
  creditNoteId     String     @db.Uuid
  creditNote       CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  saleNoteItemId   String?    @db.Uuid
  variantId        String?    @db.Uuid
  sku              String?
  description      String
  quantity         Decimal    @db.Decimal(18, 6)
  unitPrice        Decimal    @db.Decimal(18, 4)
  taxRate          Decimal    @default(0) @db.Decimal(5, 4)
  lineTotal        Decimal    @db.Decimal(18, 4)
  unitCostSnapshot Decimal?   @db.Decimal(18, 4)

  @@index([creditNoteId])
  @@index([organizationId, saleNoteItemId])
}

// ---------------------------------------------------------------------------
// Notificaciones (Prompt 9) — ADR-026 (centro de notificaciones in-app)
// ---------------------------------------------------------------------------

enum NotificationType {
  LOW_STOCK
  INVENTORY_DRIFT
  PAYMENT_PENDING
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// Notificación in-app. recipientUserId nulo = difusión a toda la organización.
// dedupeKey evita repetir una misma alerta recurrente (ver ADR-026).
model Notification {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @db.Uuid
  recipientUserId String?              @db.Uuid
  type            NotificationType
  severity        NotificationSeverity @default(INFO)
  title           String
  body            String
  entityType      String?
  entityId        String?
  dedupeKey       String?
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  @@index([organizationId, recipientUserId, readAt])
  @@index([organizationId, readAt])
  @@index([organizationId, dedupeKey])
}
