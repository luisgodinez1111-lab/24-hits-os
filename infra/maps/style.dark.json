{
  "version": 8,
  "name": "24 HITS Night (base editable)",
  "metadata": { "note": "Base oscura para tu mapa self-hosted. Ábrela en Maputnik (https://maputnik.github.io) para refinar colores/tipografía. Reemplaza TU-DOMINIO por donde publiques el .pmtiles, los glyphs y (opcional) el sprite." },
  "glyphs": "https://TU-DOMINIO/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://https://TU-DOMINIO/chihuahua.pmtiles"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#0b1020" } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#0e1b2e" } },

    { "id": "landuse-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "park"],
      "paint": { "fill-color": "#0f1c17", "fill-opacity": 0.6 } },

    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#10201a", "fill-opacity": 0.5 } },

    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#2b3346", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 3, 19, 8] } },

    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#3a445f", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 6, 19, 14] } },

    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#4a5673", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 16, 9, 19, 18] } },

    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#5b6890", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 16, 11, 19, 22] } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#1a2030", "fill-opacity": 0.7 } },

    { "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#c7d0e6", "text-halo-color": "#0b1020", "text-halo-width": 1.4 } },

    { "id": "place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village", "suburb", "neighbourhood"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Medium"], "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 18] },
      "paint": { "text-color": "#e6ebf7", "text-halo-color": "#0b1020", "text-halo-width": 1.6 } }
  ]
}
